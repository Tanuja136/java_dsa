    {
      "id": "6coTxzXHUMawkrgm7sNL7",
      "type": "text",
      "x": 2461.5598701261333,
      "y": 4886.454001926018,
      "width": 930.1153011332208,
      "height": 1055.5901144276845,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 80,
      "groupIds": [],
      "frameId": null,
      "index": "b2S",
      "roundness": null,
      "seed": 702383238,
      "version": 107,
      "versionNonce": 979241926,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1751358007686,
      "link": null,
      "locked": false,
      "text": "class Solution\n{\n    public ArrayList<String> findPermutation(String s)\n    {\n        // Code here\n        Set<String> ans=new HashSet<>();\n        genPer(s, \"\",ans);\n        return new ArrayList(ans);\n    }\n    public void genPer(String s, String a, Set<String> result)\n    {\n        if(s.isEmpty())\n        {\n            result.add(a);\n            return;\n        }\n        for(int i=0;i<s.length();i++)\n        {\n            char ch=s.charAt(i);\n            String nq=s.substring(0,i)+s.substring(i+1);\n            genPer(nq,a+ch,result);\n        }\n    }\n}",
      "fontSize": 35.186337147589484,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "class Solution\n{\n    public ArrayList<String> findPermutation(String s)\n    {\n        // Code here\n        Set<String> ans=new HashSet<>();\n        genPer(s, \"\",ans);\n        return new ArrayList(ans);\n    }\n    public void genPer(String s, String a, Set<String> result)\n    {\n        if(s.isEmpty())\n        {\n            result.add(a);\n            return;\n        }\n        for(int i=0;i<s.length();i++)\n        {\n            char ch=s.charAt(i);\n            String nq=s.substring(0,i)+s.substring(i+1);\n            genPer(nq,a+ch,result);\n        }\n    }\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
