      "width": 732.6642456054688,
      "height": 82.8,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bM1",
      "roundness": null,
      "seed": 950784522,
      "version": 111,
      "versionNonce": 2101730634,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1751443502527,
      "link": null,
      "locked": false,
      "text": "Directed (Digraph): edges have direction (A → B\nmeans you can only go from A to B).",
      "fontSize": 36,
      "fontFamily": 7,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Directed (Digraph): edges have direction (A → B means you can only go from A to B).",
      "autoResize": false,
      "lineHeight": 1.15
    },
