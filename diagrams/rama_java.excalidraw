    {
      "id": "IMIo__wHDuvBTd7vrhTPZ",
      "type": "text",
      "x": -995.4586383358883,
      "y": -25703.53174946625,
      "width": 759.1030443097596,
      "height": 558.2833478381878,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b5y",
      "roundness": null,
      "seed": 247943244,
      "version": 1452,
      "versionNonce": 1554157179,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1751362100008,
      "link": null,
      "locked": false,
      "text": "Due to the Negative indexing we have to add\n the number of queens inserted in  the box.\n                       -3+4 =1\n                        -2+4=2\n                        -1+4=3\n                          0+4=4\n                          1+4 =5\n                          2+4=6\n                          3+4=7\n                     \n\n",
      "fontSize": 40.45531506073825,
      "fontFamily": 7,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Due to the Negative indexing we have to add\n the number of queens inserted in  the box.\n                       -3+4 =1\n                        -2+4=2\n                        -1+4=3\n                          0+4=4\n                          1+4 =5\n                          2+4=6\n                          3+4=7\n                     \n\n",
      "autoResize": true,
      "lineHeight": 1.15
    },
