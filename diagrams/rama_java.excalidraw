    {
      "id": "3DFlH9M9ykLhOM-FDdLSZ",
      "type": "text",
      "x": -1948.879653169149,
      "y": -27624.773132168866,
      "width": 451.181900230534,
      "height": 802.1792099462069,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aR",
      "roundness": null,
      "seed": 1415322612,
      "version": 1343,
      "versionNonce": 459295131,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "5GTOqE_v13OyBvo33vhkS",
          "type": "arrow"
        }
      ],
      "updated": 1751361986361,
      "link": null,
      "locked": false,
      "text": "4 disc  a->c aux:b               \n    3 disc a->b aux :c\n        2disc a->c aux:b\n            1disc a->b  aux:c\n             move a->b\n            1disc b->c aux:a\n        2 c->b aux:a\n            1disc c->a aux:b\n            1disc a->b aux:c\n    3 disc a->c aux:b\n        2disc b->c aux:c\n            1disc b->c aux :a\n            1disc c->a aux :b\n        2disc a->c aux:b\n            1disc a->b aux:c\n            1disc  a->b aux:c",
      "fontSize": 43.59669619272867,
      "fontFamily": 7,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "4 disc  a->c aux:b                                                                \n    3 disc a->b aux :c\n        2disc a->c aux:b\n            1disc a->b  aux:c\n             move a->b\n            1disc b->c aux:a\n        2 c->b aux:a\n            1disc c->a aux:b\n            1disc a->b aux:c\n    3 disc a->c aux:b\n        2disc b->c aux:c\n            1disc b->c aux :a\n            1disc c->a aux :b\n        2disc a->c aux:b\n            1disc a->b aux:c\n            1disc  a->b aux:c",
      "autoResize": false,
      "lineHeight": 1.15
    },
    {
      "id": "lZ4LSDKNr9XdLh37VIVBt",
      "type": "text",
      "x": -1296.3608709584487,
      "y": -27482.846423478633,
      "width": 266.0775058925614,
      "height": 536.5411623179291,
      "angle": 0,
