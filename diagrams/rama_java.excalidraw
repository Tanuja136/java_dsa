      "roundness": null,
      "seed": 180151894,
      "version": 121,
      "versionNonce": 643810122,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1751443500486,
      "link": null,
      "locked": false,
      "text": "Undirected: edges have no direction (A-B means\nyou can go from A to B and B to A).",
      "fontSize": 36,
      "fontFamily": 7,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Undirected: edges have no direction (A-B means you can go from A to B and B to A).",
      "autoResize": false,
      "lineHeight": 1.15
    },
    {
      "id": "K1ynreXJ7y6ggvBmLR24Z",
      "type": "text",
      "x": -1414.5815177730701,
