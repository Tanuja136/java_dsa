      "link": null,
      "locked": false,
      "text": "4acb\n    3abc\n        2acb\n            1abc\n                1:a->b\n        2:a->c\n            1bca\n                1:b->c\n    3:a->c\n",
      "fontSize": 46.65575324503734,
      "fontFamily": 7,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "4acb\n    3abc\n        2acb\n            1abc\n                1:a->b\n        2:a->c\n            1bca\n                1:b->c\n    3:a->c\n",
      "autoResize": true,
      "lineHeight": 1.15
    },
    {
      "id": "Ib_5g9aiBnzksOmyoY1eV",
      "type": "text",
      "x": -497.61545918982983,
      "y": -27350.14879431088,
      "width": 368.70032363424633,
      "height": 333.07601618353794,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aT",
      "roundness": null,
      "seed": 2049641164,
      "version": 936,
      "versionNonce": 816373467,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1751361986361,
      "link": null,
      "locked": false,
      "text": "def toh(4,a,c,b):\n            if(n == 1):\n                    move n a->c\n                    return \n            toh(n-1,a,b,c)\n            move n a->c\n            toh(n-1,b,c,a)",
      "fontSize": 41.3759026314954,
      "fontFamily": 7,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "def toh(4,a,c,b):\n            if(n == 1):\n                    move n a->c\n                    return \n            toh(n-1,a,b,c)\n            move n a->c\n            toh(n-1,b,c,a)",
      "autoResize": false,
      "lineHeight": 1.15
    },
